allow create:if C()&&A().ownerId==B()&&H(['ownerId','albumId','thumb','createdAt'])&&get(E('albums',A().albumId)).data.ownerId==B()&&D(A().thumb,1,80000)&&J(A().thumb)&&G(A().createdAt);
